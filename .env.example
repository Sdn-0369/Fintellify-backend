# ---- Server ----
# Railway injects PORT automatically; this is only for local dev.
PORT=4000

# Your deployed frontend URL (Vercel). Used for CORS.
# You can pass a comma-separated list to allow multiple origins
# (e.g. your production URL + a preview URL).
FRONTEND_URL=https://fintellify-frontend2.vercel.app/

# ---- Auth ----
# Any long random string. Keep it secret.
JWT_KEY=replace-with-a-long-random-secret

# ---- Database (Postgres) ----
# Provided by the Railway Postgres plugin.
DATABASE_URL=postgresql://user:password@host:port/dbname

# ---- Redis ----
# Provided by the Railway Redis plugin (ioredis connection string).
REDIS_KEY=redis://default:password@host:port

# ---- Google Gemini (Generative AI) ----
AI_KEY=your-google-generative-ai-api-key

# ---- Tavily (web search) ----
TAVILY_KEY=your-tavily-api-key
